# ===================================================
# Discord Clipping Agency Platform - Environment Config
# ===================================================

# Environment mode ('development' or 'production')
NODE_ENV=development

# Logging level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_development_guild_id_here

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Neon: DATABASE_URL uses pooled connection string (with connect_timeout=15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipping_db?schema=public
# For Neon migrations: DIRECT_URL uses direct/unpooled connection string
DIRECT_URL=

# Redis Connection (Used by BullMQ for background workers & queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Future API Port (if HTTP health checks/webhooks/API are enabled)
PORT=3000

# Social Platform Provider Credentials (Optional / Automated Verification)
# YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=

# Apify API Token (For automated TikTok & Facebook public metric scrapers)
# Obtain from https://console.apify.com/account/integrations
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-reels-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks/free-tiktok-scraper
APIFY_TIMEOUT_SECS=60

# Scheduled Metric Polling (Phase 6)
METRIC_POLL_INTERVAL_MINUTES=60
METRIC_POLL_BATCH_SIZE=50
METRIC_POLL_MAX_ATTEMPTS=3
METRIC_POLL_BACKOFF_MS=5000
METRIC_POLL_ENABLED=true

# Application Rate Limiting
RATE_LIMIT_SUBMIT_PER_MINUTE=10
RATE_LIMIT_PAYOUT_PER_MINUTE=5

# Staff & Admin Roles (comma-separated Discord role IDs)
DISCORD_ADMIN_ROLE_IDS=
DISCORD_CAMPAIGN_MANAGER_ROLE_IDS=
# Set to true if Discord native Administrator permission should grant full ADMIN role (default: false)
ADMIN_FROM_DISCORD_ADMINISTRATOR=false

# Creator & Verified Roles (Discord role IDs)
DISCORD_CREATOR_ROLE_ID=
# Optional: if set, user must hold this external verified role to register as a creator
CLIENT_VERIFIED_ROLE_ID=

# Optional Live Integration Testing (Phase 7)
RUN_PROVIDER_INTEGRATION_TESTS=false
